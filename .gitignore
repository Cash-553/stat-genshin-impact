# 个人数据（不上传）
data/
config/
icons/

# 开发测试文件
_开发测试/
_开发测试_new/
_demo_icons/

# Python 缓存
__pycache__/
*.pyc

# 打包产物
build/
dist/
*.spec
!StatGI.spec
*.exe
发布版/*
# 例外：公告文件必须进仓库 —— 程序是从 raw 地址（Gitee / GitHub）拉公告的，
# 不在仓库里就拉不到。所以这个子文件夹要放行。
!发布版/公告/
# 发布工具（在 发布版\发布\ 里）也要进仓库。
# 注意顺序：得先把「发布」这个目录本身放行（git 不会进被忽略的目录），
# 再把里面的 v<版本号>\ 重新忽略掉 —— 那里面是几十兆的分卷。
!发布版/发布/
发布版/发布/v*/
StatGI/
原神挂机收益统计器/

# v6 OCR 实验残留（已回退 RapidOCR，不上传）
assets/
ocr_v6.py
_dev_*.png

# 用户数据（7.0掉落物JSON等）
新建文件夹/

# 文档（仅本地，不上传）
使用说明.txt
.github/
docs/

# 自用直播间美化页面（不发布）
直播间美化.html

# 系统文件
Thumbs.db
Desktop.ini

# AI 训练样本数据集（本地，绝不上传/不提交）
dataset/
gameplay/
non_gameplay/
dataset_stats.json

# 临时验证脚本（跑完就该删，别提交）
_run*.py
_r*.txt

# 自动更新的分卷（几十兆的二进制，不进仓库 —— Gitee 仓库单文件限 50M）
发布版/公告/更新包分卷/
# 自动更新生成的更新脚本（运行时产物）
更新.bat
# 每次发版生成的一键安装脚本
发布版/公告/一键安装.bat
_e2e*.py
_upd_e2e/
